    "bio_intro": "My research is situated at the intersection of Numerical Analysis, Scientific Computing, and Computational Materials Science. I focus on developing mathematically rigorous and computationally efficient methods for molecular modeling and multi-scale simulation. My specific research directions include:",
    "research_directions": [
      {
        "heading": "1. AI for Science (AI4Science) & Foundation Models",
        "items": [
          {
            "subtitle": "LLMs for Scientific Discovery:",
            "text": "Investigating the integration of Large Language Models (LLMs) and specialized foundation models to accelerate scientific workflows, automate property prediction, and facilitate \"inverse design\" in materials science."
          },
          {
            "subtitle": "Scientific & Quantum Machine Learning:",
            "text": "Developing data-driven solvers and Quantum Machine Learning (QML) techniques for solving high-dimensional PDEs. My work emphasizes the development of robust numerical algorithms with a focus on Uncertainty Quantification (UQ) and the theoretical analysis of convergence and generalization."
          }
        ]
      },
      {
        "heading": "2. Machine-Learned Interatomic Potentials (MLIPs)",
        "items": [
          {
            "subtitle": "Numerical Analysis of MLIPs:",
            "text": "Advancing the mathematical foundation of interatomic potentials by investigating approximation errors, stability, and the reliability of force-field predictions."
          },
          {
            "subtitle": "Multi-Fidelity & Coarse-Graining:",
            "text": "Developing systematic approaches for fine-tuning pre-trained models and constructing coarse-grained (CG) force fields for soft-matter systems."
          },
          {
            "subtitle": "Applications in Materials:",
            "text": "Applying these potentials to study complex phenomena in energy storage and conversion materials, ensuring a seamless integration of physics-based priors with data-driven flexibility."
          }
        ]
      },
      {
        "heading": "3. Multi-scale Modeling of Crystalline Defects",
        "items": [
          {
            "subtitle": "Coupling Methods:",
            "text": "Engineering and analyzing Atomistic-to-Continuum (A/C) and Quantum Mechanics/Molecular Mechanics (QM/MM) coupling schemes."
          },
          {
            "subtitle": "Rigorous Error Estimation:",
            "text": "Implementing both a priori and a posteriori error analysis to guide the development of adaptive algorithms that balance accuracy and computational cost."
          },
          {
            "subtitle": "Boundary Conditions:",
            "text": "Formulating sophisticated boundary conditions to accurately capture the long-range strain fields associated with crystalline defects."
          }
        ]
      },
      {
        "heading": "4. Microstructure Evolution & Computational Materials Design",
        "items": [
          {
            "subtitle": "Data-Driven Microstructure Modeling:",
            "text": "Utilizing machine learning to decipher the kinetics of microstructure evolution in complex systems, including optical and magnetic materials."
          },
          {
            "subtitle": "Multi-scale Property Prediction:",
            "text": "Intersection of multiscale behavior and surrogate modeling to predict macroscopic material performance from mesoscopic morphological data, facilitating the accelerated design of high-performance materials."
          }
        ]
      }
    ]
  },
